# Everything works with no keys at all. These only switch on optional free-tier upgrades.

# OpenRouteService (free tier, 2,000 requests/day) — road-following route lines.
# Without it, Along uses the free OpenStreetMap community OSRM servers.
ORS_API_KEY=

# Azure Speech (free F0 tier, 500k characters/month) — Nigerian English voices (Ezinne, Abeo).
# Without it, Along uses the phone's built-in voice. Server-side only; never expose in frontend code.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud TTS (set ACTIVE_PROVIDER in lib/tts-config.ts to switch)
# GOOGLE_TTS_API_KEY=

# ElevenLabs (set ACTIVE_PROVIDER in lib/tts-config.ts to switch)
# ELEVENLABS_API_KEY=
