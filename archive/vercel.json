{
  "rewrites": [{ "source": "/api/tts", "destination": "/api/tts" }],
  "headers": [
    {
      "source": "/(styles\\.css|app\\.js|sw\\.js|vendor/.*|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
